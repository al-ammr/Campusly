# ==============================================================================
# Campusly Environment Variables Template (.env.example)
# Do not store real credentials or secrets in this file.
# ==============================================================================

# --- Server-Only: Database (PostgreSQL) ---
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Server-Only: Rate Limiting & Cache (Redis) ---
REDIS_URL=
REDIS_TOKEN=

# --- Server-Only: Authentication & Security Keys ---
SESSION_SECRET=
JOB_SECRET=
DATA_ENCRYPTION_KEY=

# --- Server-Only: S3 / Cloudflare R2 Direct Uploads ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=

# --- Server-Only: Transactional Email Service ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Client-Safe: Public App Config ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEFAULT_CAMPUS_SLUG=
NEXT_PUBLIC_BUILD_ID=
